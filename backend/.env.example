# ─────────────────────────────────────────────────────────────
# .env.example — Copy to .env and fill in your values
# NEVER commit the real .env file to version control
# ─────────────────────────────────────────────────────────────

# Django core
SECRET_KEY=your-very-secret-django-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,your-railway-domain.up.railway.app

# Supabase PostgreSQL direct connection string
# Format: postgresql://postgres:[password]@[host]:[port]/postgres
SUPABASE_DB_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres

# Supabase project credentials
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Google Gemini (STT + LLM + embeddings)
GOOGLE_API_KEY=your-google-api-key

# OpenAI (Whisper STT + GPT-4o LLM + text-embedding-3-small)
OPENAI_API_KEY=sk-your-openai-api-key

# ElevenLabs TTS
ELEVENLABS_API_KEY=your-elevenlabs-api-key
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# HuggingFace Inference API (emotion detection)
HUGGINGFACE_API_KEY=hf_your-huggingface-api-key

# Redis (Celery broker)
REDIS_URL=redis://localhost:6379/0

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173
